{
  "name": "innernavi-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": { "node": "24.19.0", "npm": "11.17.0" },
  "scripts": {
    "preinstall": "node ../../scripts/check-node.mjs",
    "predev": "node ../../scripts/check-node.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "pretypecheck": "node ../../scripts/check-node.mjs",
    "typecheck": "vue-tsc --noEmit",
    "prebuild": "node ../../scripts/check-node.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "pretest": "node ../../scripts/check-node.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "pinia": "4.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "vite": "8.3.2",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.11",
    "vitest": "5.0.3"
  }
}
